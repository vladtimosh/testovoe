<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Конфигурация для AuthorServlet -->
    <servlet>
        <servlet-name>AuthorServlet</servlet-name>
        <servlet-class>org.example.servlet.AuthorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthorServlet</servlet-name>
        <url-pattern>/authors</url-pattern>
    </servlet-mapping>

    <!-- Конфигурация для BookServlet -->
    <servlet>
        <servlet-name>BookServlet</servlet-name>
        <servlet-class>org.example.servlet.BookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookServlet</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>

    <!-- Конфигурация для GenreServlet -->
    <servlet>
        <servlet-name>GenreServlet</servlet-name>
        <servlet-class>org.example.servlet.GenreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GenreServlet</servlet-name>
        <url-pattern>/genres</url-pattern>
    </servlet-mapping>

    <!-- Конфигурация для LoanServlet -->
    <servlet>
        <servlet-name>LoanServlet</servlet-name>
        <servlet-class>org.example.servlet.LoanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoanServlet</servlet-name>
        <url-pattern>/loans</url-pattern>
    </servlet-mapping>

    <!-- Конфигурация для MemberServlet -->
    <servlet>
        <servlet-name>MemberServlet</servlet-name>
        <servlet-class>org.example.servlet.MemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemberServlet</servlet-name>
        <url-pattern>/members</url-pattern>
    </servlet-mapping>

</web-app>